# Copy these settings into server/.env or the deployment secret manager.
# Use the pooled connection from Supabase Connect for runtime traffic.
# URL-encode special characters in the password.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@POOLER_HOST:6543/DB_NAME?pgbouncer=true&connection_limit=1&schema=itro"

# Use the Supabase direct connection for Prisma migrations and schema inspection.
# If direct IPv6 is unavailable in your environment, use the Supabase session pooler.
DIRECT_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?schema=itro"
