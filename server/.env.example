# Copy to .env and replace placeholders with your local values.
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/itro?schema=itro
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
SUPERADMIN_INITIAL_PASSWORD=
SEED_SUPERADMIN_EMAIL=super@rix.local
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5000

# Local offline development uses local disk; production requires s3.
STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=C:\path\to\persistent\server-data

# AWS S3 or Cloudflare R2 (production)
# STORAGE_DRIVER=s3
# S3_BUCKET_NAME=itro-media
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# STORAGE_PUBLIC_BASE_URL=https://media.example.com

# Prisma direct connection for migrations. For local PostgreSQL this may match DATABASE_URL.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/itro?schema=itro
