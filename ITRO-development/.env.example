# ---- Server ----
NODE_ENV=development
PORT=4000
# Point at your Postgres. App tables live in a dedicated schema (e.g. "itro").
# URL-encode special chars in the password (! -> %21, # -> %23).
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME?schema=itro"
JWT_SECRET="change-me-in-production-a-long-random-string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
PUBLIC_API_URL="http://localhost:4000"

# ---- Platform white-label defaults (overridable per-tenant) ----
PLATFORM_NAME="ITRO"
PLATFORM_TAGLINE="Indian Testing & Research Organisation"
PLATFORM_PRIMARY_COLOR="#0000ff"
PLATFORM_DEFAULT_CURRENCY="INR"
PLATFORM_DEFAULT_TAX_RATE="0.18"
PLATFORM_TAKE_RATE="0.20"

# ---- Web (Vite) ----
VITE_API_URL="http://localhost:4000/api"
VITE_PLATFORM_NAME="ITRO"
