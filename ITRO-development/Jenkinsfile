// ITRO — Jenkins Pipeline
// Build with Parameters: COMMIT_ID / BRANCH, ENVIRONMENT, BUILD_OPTION, RUN_SONARQUBE
//
// Assumptions you should verify/adjust before first run (search "ADJUST ME"):
//   - Jenkins agent's default SSH key (~/.ssh/id_ed25519 or similar) already has
//     access to ubuntu@34.100.132.196 and its public key is authorized on that host
//   - Repo is deployed under a per-environment path on the target server
//   - PM2 process names are per-environment (e.g. itro-api-dev, itro-api-stage, itro-api-prod)
//   - nginx already has server blocks per environment/domain (see DEPLOYMENT.md)
//   - Node 20 LTS is available on both the Jenkins agent and the deploy target

pipeline {
    agent any

    parameters {
        string(
            name: 'COMMIT_ID',
            defaultValue: '',
            description: 'Optional Commit ID (overrides BRANCH if set)'
        )
        choice(
            name: 'BRANCH',
            choices: ['development', 'main'],
            description: 'Git Branch (used only if COMMIT_ID is empty)'
        )
        choice(
            name: 'ENVIRONMENT',
            choices: ['production'],
            description: 'Target environment'
        )
        choice(
            name: 'BUILD_OPTION',
            choices: ['frontend', 'backend', 'both', 'sonarqube'],
            description: 'What to build/deploy'
        )
        booleanParam(
            name: 'RUN_SONARQUBE',
            defaultValue: false,
            description: 'Run SonarQube scan (also runs automatically if BUILD_OPTION = sonarqube)'
        )
    }

    environment {
        // ---- ADJUST ME: repo + workspace layout ----
        GIT_URL   = 'git@github.com:BOSTONHANA/ITRO.git'
        REPO_DIR  = 'ITRO'
        // Git auth uses the Jenkins agent's default SSH key (already trusted by GitHub) —
        // no Jenkins credential lookup needed.

        // NOTE: DEPLOY_HOST / DEPLOY_PATH / PM2_APP_NAME / VITE_API_URL / CORS_ORIGIN
        // are deliberately NOT declared here. They're set dynamically via env.X in the
        // "Resolve Environment Config" stage. Declaring them here with a static value
        // causes Jenkins to reset them back to that value on later stages.

        // SSH uses the Jenkins agent's default key (e.g. ~/.ssh/id_ed25519) —
        // no Jenkins credential lookup needed.

        // ---- SonarQube ----
        SONAR_PROJECT_KEY = 'itro-platform'
        SONAR_HOST_URL    = 'http://3.6.251.121:9000'
        SONAR_TOKEN_ID    = 'sonarqube_tokan_ITRO'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {

        stage('Resolve Environment Config') {
            steps {
                script {
                    // Map ENVIRONMENT -> host/path/pm2 name.
                    // Only 'production' is enabled for now; add dev/stage back here
                    // (and to the ENVIRONMENT choice parameter above) once those boxes exist.
                    def envConfig = [
                        production: [
                            host: '34.100.132.196',
                            path: '/home/ubuntu/ITRO-development',
                            pm2Server: 'itro-api',
                            apiUrl: 'https://itro.co.in/api',
                            corsOrigin: 'https://itro.co.in'
                        ]
                    ]

                    echo "params.ENVIRONMENT = '${params.ENVIRONMENT}'"
                    def cfg = envConfig[params.ENVIRONMENT]
                    if (cfg == null) {
                        error("No deployment config found for ENVIRONMENT=${params.ENVIRONMENT}")
                    }

                    env.DEPLOY_HOST  = cfg.host
                    env.DEPLOY_PATH  = cfg.path
                    env.PM2_APP_NAME = cfg.pm2Server
                    env.VITE_API_URL = cfg.apiUrl
                    env.CORS_ORIGIN  = cfg.corsOrigin

                    echo "Resolved deploy target -> host: ${env.DEPLOY_HOST}, path: ${env.DEPLOY_PATH}, pm2: ${env.PM2_APP_NAME}"

                    if (params.ENVIRONMENT == 'production') {
                        echo "⚠️  Deploying to PRODUCTION"
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    if (params.COMMIT_ID?.trim()) {
                        echo "Checking out specific commit: ${params.COMMIT_ID}"
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: params.COMMIT_ID]],
                            userRemoteConfigs: [[url: env.GIT_URL]]
                        ])
                    } else {
                        echo "Checking out branch: ${params.BRANCH}"
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${params.BRANCH}"]],
                            userRemoteConfigs: [[url: env.GIT_URL]]
                        ])
                    }
                }
                sh 'git rev-parse HEAD'
            }
        }

        stage('Install Dependencies') {
            when {
                expression { params.BUILD_OPTION != 'sonarqube' }
            }
            steps {
                // Workspace monorepo — install once at the root (server + web are npm workspaces)
                sh 'npm ci'
                sh 'cd server && npx prisma generate'
            }
        }

        stage('Build Backend') {
            when {
                expression { params.BUILD_OPTION == 'backend' || params.BUILD_OPTION == 'both' }
            }
            steps {
                sh 'npm --workspace server run build'
            }
        }

        stage('Build Frontend') {
            when {
                expression { params.BUILD_OPTION == 'frontend' || params.BUILD_OPTION == 'both' }
            }
            steps {
                sh """
                    printf 'VITE_API_URL=${env.VITE_API_URL}\\nVITE_PLATFORM_NAME=ITRO\\n' > web/.env.production
                    npm --workspace web run build
                """
            }
        }

        stage('SonarQube Scan') {
            when {
                anyOf {
                    expression { params.RUN_SONARQUBE == true }
                    expression { params.BUILD_OPTION == 'sonarqube' }
                }
            }
            steps {
                withSonarQubeEnv('sonarqube_ITRO') { // matches the SonarQube server name configured in Jenkins > Configure System
                    withCredentials([string(credentialsId: env.SONAR_TOKEN_ID, variable: 'SONAR_TOKEN')]) {
                        sh """
                            npx sonar-scanner \
                              -Dsonar.projectKey=${env.SONAR_PROJECT_KEY} \
                              -Dsonar.sources=server/src,web/src \
                              -Dsonar.host.url=${env.SONAR_HOST_URL} \
                              -Dsonar.login=\$SONAR_TOKEN
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            when {
                anyOf {
                    expression { params.RUN_SONARQUBE == true }
                    expression { params.BUILD_OPTION == 'sonarqube' }
                }
            }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy Backend') {
            when {
                expression { params.BUILD_OPTION == 'backend' || params.BUILD_OPTION == 'both' }
            }
            steps {
                sh """
                    # npm workspaces hoist deps + the lock file to the repo root, so the
                    # root package.json/package-lock.json must ship too — not just server/ —
                    # or `npm ci` at DEPLOY_PATH root goes stale against server's deps.
                    rsync -az package.json package-lock.json ubuntu@${env.DEPLOY_HOST}:${env.DEPLOY_PATH}/

                    rsync -az \
                      --exclude 'node_modules' \
                      --exclude '.env' \
                      --exclude 'uploads' \
                      server/ ubuntu@${env.DEPLOY_HOST}:${env.DEPLOY_PATH}/server/

                    ssh ubuntu@${env.DEPLOY_HOST} bash -l <<'REMOTE_SCRIPT'
set -e
export NVM_DIR="\$HOME/.nvm"
[ -s "\$NVM_DIR/nvm.sh" ] && . "\$NVM_DIR/nvm.sh"
nvm use default >/dev/null 2>&1 || nvm use node >/dev/null 2>&1 || true
cd ${env.DEPLOY_PATH}
npm ci
cd server
npx prisma generate
npx prisma migrate deploy
npm run build
pm2 restart ${env.PM2_APP_NAME} --update-env || pm2 start dist/index.js --name ${env.PM2_APP_NAME} --update-env
pm2 save
REMOTE_SCRIPT
                """
            }
        }

        stage('Deploy Frontend') {
            when {
                expression { params.BUILD_OPTION == 'frontend' || params.BUILD_OPTION == 'both' }
            }
            steps {
                sh """
                    rsync -az \
                      web/dist/ ubuntu@${env.DEPLOY_HOST}:${env.DEPLOY_PATH}/web/dist/
                """
            }
        }

        stage('Post-Deploy Health Check') {
            when {
                expression { params.BUILD_OPTION != 'sonarqube' }
            }
            steps {
                sh """
                    sleep 5
                    curl -f ${env.VITE_API_URL}/health || (echo 'Health check failed' && exit 1)
                """
            }
        }
    }

    post {
        success {
            echo "✅ Build/Deploy succeeded — ENVIRONMENT=${params.ENVIRONMENT}, BUILD_OPTION=${params.BUILD_OPTION}, ref=${params.COMMIT_ID ?: params.BRANCH}"
        }
        failure {
            echo "❌ Build/Deploy failed — check console output above."
        }
    }
}
